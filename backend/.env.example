# Django
DEBUG=True
SECRET_KEY=
DATABASE_URL=
TEST_DATABASE_URL=

# Email — keep one block active (local console vs remote SES):
# Local (prints to runserver console; required so registration can send confirmation):
EMAIL_PROVIDER=console
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Judkins Park P-Patch <noreply@example.com>
FRONTEND_URL=http://localhost:5173

# Remote (SES SMTP) — uncomment for Render/production; comment out Local above:
# EMAIL_PROVIDER=ses
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=email-smtp.us-west-2.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=<ses-smtp-username>
# EMAIL_HOST_PASSWORD=<ses-smtp-password>
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SES_REGION=us-west-2
