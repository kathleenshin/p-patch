# Django
DEBUG=True
SECRET_KEY=
DATABASE_URL=
TEST_DATABASE_URL=

# Email — NotificationService picks console vs SES via EMAIL_PROVIDER.
# Registration + email-change confirmations both use that path (not Django SMTP).
#
# Local (prints to runserver console):
EMAIL_PROVIDER=console
DEFAULT_FROM_EMAIL=Judkins Park P-Patch <noreply@example.com>
FRONTEND_URL=http://localhost:5173

# Remote (SES API via boto3) — uncomment for real delivery; comment out Local above:
# EMAIL_PROVIDER=ses
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SES_REGION=us-west-2
# USE_MOCK_WEATHER=True
# DEFAULT_FROM_EMAIL=Judkins Park P-Patch <noreply@your-verified-domain.com>
# Optional override (defaults to DEFAULT_FROM_EMAIL):
# NOTIFICATIONS_EMAIL_SENDER=Judkins Park P-Patch <noreply@your-verified-domain.com>
# FRONTEND_URL=https://your-frontend.example.com
#
# Notes:
# - Set USE_MOCK_WEATHER=True on Render to force the deployment-safe mock forecast.
# - From address (or its domain) must be verified in SES.
# - In SES sandbox, recipient addresses must also be verified.
# - EMAIL_BACKEND / EMAIL_HOST* are unused when EMAIL_PROVIDER=ses.
